{
  "info": {
    "name": "CinePrime — Issue #162 (Invite/Activation-link Account Flow)",
    "description": "Test data cho Issue #161/#162: admin tạo account (PENDING) -> email activation link -> employee tự đặt mật khẩu -> admin resend nếu link hết hạn. Chạy theo đúng thứ tự các folder 00 -> 04. Một số request cần dán thủ công token lấy từ email/DB (xem hướng dẫn trong file test guide đi kèm).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminUsername", "value": "admin" },
    { "key": "adminPassword", "value": "admin" },
    { "key": "adminToken", "value": "" },
    { "key": "memberEmail", "value": "" },
    { "key": "memberAccountId", "value": "" },
    { "key": "memberUsername", "value": "" },
    { "key": "employeeEmail", "value": "" },
    { "key": "employeeAccountId", "value": "" },
    { "key": "employeeUsername", "value": "" },
    { "key": "newPassword", "value": "Password123!" },
    { "key": "activationToken", "value": "", "description": "Dán thủ công: token của memberAccountId lấy từ email hoặc SQL (bảng password_reset)" },
    { "key": "employeeOldActivationToken", "value": "", "description": "Dán thủ công TRƯỚC khi chạy request Resend (folder 04) — token hiện tại của employeeAccountId, để verify nó bị vô hiệu sau resend" }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.result.token);",
                  "pm.test('Received token', () => pm.expect(json.result.token).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Seed admin có sẵn trong data.sql: admin / admin (app.admin.username / app.admin.password trong application.yml)."
          }
        }
      ]
    },
    {
      "name": "01 - Create Account (Part A)",
      "item": [
        {
          "name": "Create MEMBER Account",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('memberEmail', 'nguyenvan.test.' + Date.now() + '@example.com');"], "type": "text/javascript" }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('memberAccountId', json.result.accountId);",
                  "pm.collectionVariables.set('memberUsername', json.result.username);",
                  "pm.test('Account status is PENDING', () => pm.expect(json.result.status).to.eql('PENDING'));",
                  "pm.test('Username was auto-generated (non-empty)', () => pm.expect(json.result.username).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van Test\",\n  \"email\": \"{{memberEmail}}\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] },
            "description": "Không còn username/password trong request nữa (Issue #161). Backend tự sinh username, set status=PENDING, gửi email activation."
          }
        },
        {
          "name": "Create EMPLOYEE Account",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('employeeEmail', 'tranthi.employee.' + Date.now() + '@example.com');"], "type": "text/javascript" }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('employeeAccountId', json.result.accountId);",
                  "pm.collectionVariables.set('employeeUsername', json.result.username);",
                  "pm.test('Account status is PENDING', () => pm.expect(json.result.status).to.eql('PENDING'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Tran Thi Employee\",\n  \"email\": \"{{employeeEmail}}\",\n  \"role\": \"EMPLOYEE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "Get Account By Id — verify PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is PENDING', () => pm.expect(pm.response.json().result.status).to.eql('PENDING'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts/{{memberAccountId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{memberAccountId}}"] }
          }
        },
        {
          "name": "Create Account — Duplicate Email (expect 1011)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is 1011 EMAIL_EXISTED', () => pm.expect(pm.response.json().code).to.eql(1011));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Duplicate Test\",\n  \"email\": \"{{memberEmail}}\",\n  \"role\": \"MEMBER\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "Create Account — Missing fullName (expect 1005)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is 1005 INVALID_KEY', () => pm.expect(pm.response.json().code).to.eql(1005));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"missingname.{{$timestamp}}@example.com\",\n  \"role\": \"MEMBER\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "Create Account — No ADMIN token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error code is 1008 UNAUTHENTICATED', () => pm.expect(pm.response.json().code).to.eql(1008));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"No Auth Test\",\n  \"email\": \"noauth.{{$timestamp}}@example.com\",\n  \"role\": \"MEMBER\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          }
        }
      ]
    },
    {
      "name": "02 - Login Guard for PENDING account",
      "item": [
        {
          "name": "Login while PENDING (expect 1029)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Error code is 1029 ACCOUNT_PENDING_ACTIVATION', () => pm.expect(pm.response.json().code).to.eql(1029));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{memberUsername}}\",\n  \"password\": \"anything123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Mật khẩu ở đây không quan trọng — account đang PENDING nên bị chặn trước khi so khớp password."
          }
        }
      ]
    },
    {
      "name": "03 - Activate Account (Part B)",
      "item": [
        {
          "name": "Activate — fake/invalid token (expect 1026)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is 1026 ACTIVATION_TOKEN_INVALID', () => pm.expect(pm.response.json().code).to.eql(1026));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"this-token-does-not-exist-in-db\",\n  \"newPassword\": \"{{newPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/activate-account", "host": ["{{baseUrl}}"], "path": ["api", "auth", "activate-account"] }
          }
        },
        {
          "name": "Activate — password too short (expect 1005)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is 1005 INVALID_KEY', () => pm.expect(pm.response.json().code).to.eql(1005));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{activationToken}}\",\n  \"newPassword\": \"short\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/activate-account", "host": ["{{baseUrl}}"], "path": ["api", "auth", "activate-account"] },
            "description": "CẦN dán trước biến collection 'activationToken' (lấy từ email hoặc SQL — xem test guide) trỏ tới memberAccountId. Token sai định dạng vẫn OK vì lỗi validate password xảy ra trước khi lookup token."
          }
        },
        {
          "name": "Activate — valid token (dán activationToken trước!)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Message confirms activation', () => pm.expect(pm.response.json().message).to.include('activated'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{activationToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/activate-account", "host": ["{{baseUrl}}"], "path": ["api", "auth", "activate-account"] }
          }
        },
        {
          "name": "Login after activation (expect success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Received token', () => pm.expect(pm.response.json().result.token).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{memberUsername}}\",\n  \"password\": \"{{newPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Activate — reuse same token again (expect 1028)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is 1028 ACTIVATION_TOKEN_ALREADY_USED', () => pm.expect(pm.response.json().code).to.eql(1028));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{activationToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/activate-account", "host": ["{{baseUrl}}"], "path": ["api", "auth", "activate-account"] }
          }
        }
      ]
    },
    {
      "name": "04 - Resend Activation (Part C)",
      "item": [
        {
          "name": "Resend Activation — success (employee, still PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Message confirms resend', () => pm.expect(pm.response.json().message).to.include('resent'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts/{{employeeAccountId}}/resend-activation", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{employeeAccountId}}", "resend-activation"] },
            "description": "TRƯỚC khi chạy request này: chạy SQL lấy token hiện tại của employeeAccountId và dán vào biến 'employeeOldActivationToken' — dùng để verify ở request cuối cùng của folder này."
          }
        },
        {
          "name": "Resend Activation — no admin token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error code is 1008 UNAUTHENTICATED', () => pm.expect(pm.response.json().code).to.eql(1008));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/accounts/{{employeeAccountId}}/resend-activation", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{employeeAccountId}}", "resend-activation"] }
          }
        },
        {
          "name": "Resend Activation — already ACTIVE account (expect 1030)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is 1030 ACCOUNT_ALREADY_ACTIVE', () => pm.expect(pm.response.json().code).to.eql(1030));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts/{{memberAccountId}}/resend-activation", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{memberAccountId}}", "resend-activation"] },
            "description": "memberAccountId đã ACTIVE ở folder 03 rồi -> phải bị từ chối."
          }
        },
        {
          "name": "Activate — old employee token after resend (expect 1028)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is 1028 ACTIVATION_TOKEN_ALREADY_USED', () => pm.expect(pm.response.json().code).to.eql(1028));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{employeeOldActivationToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/activate-account", "host": ["{{baseUrl}}"], "path": ["api", "auth", "activate-account"] },
            "description": "Verify resend đã invalidate token cũ (invalidatePendingResets set is_used=true) — token cũ giờ trả lỗi 'already used', không phải 'invalid'."
          }
        }
      ]
    }
  ]
}
