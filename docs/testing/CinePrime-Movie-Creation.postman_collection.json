    {
      "name": "03 - Current Gap Cases",
      "description": "Cac request nay xac nhan hanh vi hien tai dang thieu business validation. Test pass khong co nghia la business rule dung.",
      "item": [
        {
          "name": "MC-GAP-01 - Create Minimal Draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current behavior: HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Minimal movie is DRAFT', () => pm.expect(body.result.status).to.eql('DRAFT'));",
                  "pm.collectionVariables.set('gapMovieId', body.result.movieId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"originalTitle\": \"Minimal Readiness Gap {{runId}}\",\n  \"originalLanguage\": \"vi\",\n  \"durationMinutes\": 90,\n  \"genreIds\": [{{genreId}}],\n  \"formatIds\": [{{formatId}}]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/movies"
          }
        },
        {
          "name": "MC-GAP-02 - Public Can Get DRAFT By ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Current behavior: public gets HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Returned DRAFT', () => pm.expect(pm.response.json().result.status).to.eql('DRAFT'));"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/movies/{{gapMovieId}}" }
        },
        {
          "name": "MC-GAP-01B - Minimal Draft Can Be Submitted",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Current behavior: incomplete movie accepted', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/movies/{{gapMovieId}}/submit"
          }
        },
        {
          "name": "MC-GAP-03 - End Date Before Release Date Is Accepted",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Current behavior: invalid date relation accepted', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"originalTitle\": \"Invalid Date Relation {{runId}}\",\n  \"originalLanguage\": \"vi\",\n  \"durationMinutes\": 90,\n  \"releaseDate\": \"{{endDate}}\",\n  \"endDate\": \"{{releaseDate}}\",\n  \"genreIds\": [{{genreId}}],\n  \"formatIds\": [{{formatId}}]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/movies"
          }
        }
      ]
    }
  ]
}
