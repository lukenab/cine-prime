{
  "info": {
    "name": "CinePrime - Movie Creation Tests",
    "description": "Collection test luong tao Movie. Chay folder theo thu tu 00 -> 03. Mac dinh goi qua API Gateway http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', Date.now().toString());",
          "}",
          "function localDatePlusDays(days) {",
          "  const date = new Date();",
          "  date.setDate(date.getDate() + days);",
          "  const year = date.getFullYear();",
          "  const month = String(date.getMonth() + 1).padStart(2, '0');",
          "  const day = String(date.getDate()).padStart(2, '0');",
          "  return `${year}-${month}-${day}`;",
          "}",
          "pm.collectionVariables.set('releaseDate', localDatePlusDays(30));",
          "pm.collectionVariables.set('endDate', localDatePlusDays(60));",
          "pm.collectionVariables.set('movieTitle', 'The Last Horizon ' + pm.collectionVariables.get('runId'));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminUsername", "value": "admin" },
    { "key": "adminPassword", "value": "admin" },
    { "key": "adminToken", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "releaseDate", "value": "" },
    { "key": "endDate", "value": "" },
    { "key": "movieTitle", "value": "" },
    { "key": "genreId", "value": "" },
    { "key": "formatId", "value": "" },
    { "key": "ageRatingId", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "directorId", "value": "" },
    { "key": "actorId", "value": "" },
    { "key": "movieId", "value": "" },
    { "key": "gapMovieId", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "description": "Chay folder nay truoc de login va lay cac ID tham chieu.",
      "item": [
        {
          "name": "00.1 - Login Admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Co access token', () => pm.expect(body.result.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('adminToken', body.result.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Neu admin/admin khong dung, sua Collection variables adminUsername va adminPassword."
          }
        },
        {
          "name": "00.2 - Get Genre and Save genreId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().result;",
                  "const selected = items.find(x => x.genreId === 1) || items[0];",
                  "pm.test('Co genre', () => pm.expect(selected).to.exist);",
                  "pm.collectionVariables.set('genreId', selected.genreId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/genres"
          }
        },
        {
          "name": "00.3 - Get Format and Save formatId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().result;",
                  "const selected = items.find(x => x.formatCode === '2D') || items[0];",
                  "pm.test('Co screening format', () => pm.expect(selected).to.exist);",
                  "pm.collectionVariables.set('formatId', selected.formatId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/screening-formats"
          }
        },
        {
          "name": "00.4 - Get Age Rating and Save ageRatingId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().result;",
                  "const selected = items.find(x => x.ratingCode === 'T13') || items[0];",
                  "pm.test('Co age rating', () => pm.expect(selected).to.exist);",
                  "pm.collectionVariables.set('ageRatingId', selected.ratingId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/age-ratings"
          }
        },
        {
          "name": "00.5 - Get Company and Save companyId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().result;",
                  "pm.test('Co company', () => pm.expect(items).to.be.an('array').that.is.not.empty);",
                  "pm.collectionVariables.set('companyId', items[0].companyId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/companies?q=Warner"
          }
        },
        {
          "name": "00.6 - Get Director and Save directorId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().result;",
                  "pm.test('Co director', () => pm.expect(items).to.be.an('array').that.is.not.empty);",
                  "pm.collectionVariables.set('directorId', items[0].personId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/persons?q=Denis"
          }
        },
        {
          "name": "00.7 - Get Actor and Save actorId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().result;",
                  "pm.test('Co actor', () => pm.expect(items).to.be.an('array').that.is.not.empty);",
                  "pm.collectionVariables.set('actorId', items[0].personId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/persons?q=Timoth"
          }
        }
      ]
    },
    {
      "name": "01 - Happy Path",
      "description": "Tao Movie day du, verify DRAFT, submit, approve va verify public.",
      "item": [
        {
          "name": "01.1 - Create Full Movie - Expect 200 DRAFT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Body code 200', () => pm.expect(body.code).to.eql(200));",
                  "pm.test('Movie status DRAFT', () => pm.expect(body.result.status).to.eql('DRAFT'));",
                  "pm.test('Co 2 translations', () => pm.expect(body.result.translations).to.have.length(2));",
                  "pm.test('Co 2 cast members', () => pm.expect(body.result.cast).to.have.length(2));",
                  "pm.collectionVariables.set('movieId', body.result.movieId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalTitle\": \"{{movieTitle}}\",\n  \"originalLanguage\": \"en\",\n  \"durationMinutes\": 128,\n  \"releaseDate\": \"{{releaseDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"country\": \"USA\",\n  \"ageRatingId\": {{ageRatingId}},\n  \"companyId\": {{companyId}},\n  \"genreIds\": [{{genreId}}],\n  \"formatIds\": [{{formatId}}],\n  \"posterUrl\": \"https://placehold.co/780x1170/png?text=The+Last+Horizon\",\n  \"thumbnailUrl\": \"https://placehold.co/342x513/png?text=The+Last+Horizon\",\n  \"trailerUrl\": \"https://www.youtube.com/watch?v=test\",\n  \"synopsis\": \"Mot doan tham hiem thuc hien nhiem vu cuoi cung.\",\n  \"translations\": [\n    {\"languageCode\": \"en\", \"title\": \"The Last Horizon\", \"synopsis\": \"A final mission beyond the solar system.\"},\n    {\"languageCode\": \"vi\", \"title\": \"Chan Troi Cuoi Cung\", \"synopsis\": \"Mot nhiem vu cuoi cung ben ngoai he Mat Troi.\"}\n  ],\n  \"cast\": [\n    {\"personId\": {{directorId}}, \"roleType\": \"DIRECTOR\", \"characterName\": null, \"billingOrder\": 1},\n    {\"personId\": {{actorId}}, \"roleType\": \"ACTOR\", \"characterName\": \"Commander Minh\", \"billingOrder\": 2}\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/movies"
          }
        },
        {
          "name": "01.2 - Get Created Movie - Expect DRAFT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const movie = pm.response.json().result;",
                  "pm.test('Dung movieId', () => pm.expect(movie.movieId).to.eql(Number(pm.collectionVariables.get('movieId'))));",
                  "pm.test('Status DRAFT', () => pm.expect(movie.status).to.eql('DRAFT'));",
                  "pm.test('Co vi va en', () => pm.expect(movie.translations.map(x => x.languageCode)).to.include.members(['vi', 'en']));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/movies/{{movieId}}" }
        },
        {
          "name": "01.3 - Verify DRAFT Not In Public List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const movies = pm.response.json().result;",
                  "const id = Number(pm.collectionVariables.get('movieId'));",
                  "pm.test('DRAFT khong public', () => pm.expect(movies.some(x => x.movieId === id)).to.eql(false));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/movies/public" }
        },
        {
          "name": "01.4 - Submit Movie - Expect PENDING_REVIEW",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Submitted message', () => pm.expect(pm.response.json().message).to.eql('Submitted for review'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/movies/{{movieId}}/submit"
          }
        },
        {
          "name": "01.5 - Approve Movie - Expect COMING_SOON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Approved message', () => pm.expect(pm.response.json().message).to.eql('Movie approved'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/movies/{{movieId}}/approve"
          }
        },
        {
          "name": "01.6 - Verify COMING_SOON In Public List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const movies = pm.response.json().result;",
                  "const id = Number(pm.collectionVariables.get('movieId'));",
                  "pm.test('COMING_SOON public', () => pm.expect(movies.some(x => x.movieId === id && x.status === 'COMING_SOON')).to.eql(true));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/movies/public" }
        }
      ]
    },
