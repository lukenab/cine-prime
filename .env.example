# Copy this file to .env for local development. Never commit .env.
# Generate independent, random values for every secret; do not reuse the examples below.

# Shared infrastructure
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SIGNER_KEY=replace-with-at-least-64-random-characters-for-hs512-signing
INTERNAL_SERVICE_KEY=replace-with-a-random-internal-service-key

# Movie service external providers
TMDB_API_KEY=replace-with-a-new-tmdb-api-key
TMDB_CONNECT_TIMEOUT=2s
TMDB_READ_TIMEOUT=6s
TMDB_MAX_ATTEMPTS=3
TMDB_INITIAL_BACKOFF=250ms
TMDB_MAX_BACKOFF=2s
TMDB_REQUESTS_PER_SECOND=4
TMDB_CACHE_TTL=10m
TMDB_CACHE_MAX_ENTRIES=500
MOVIE_LIFECYCLE_TIME_ZONE=Asia/Ho_Chi_Minh
MOVIE_LIFECYCLE_CLOSE_CRON=0 5 0 * * *
MOVIE_LIFECYCLE_OPEN_CRON=0 10 0 * * *
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-a-new-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-a-new-cloudinary-api-secret

# Seeded demo accounts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com
BRANCH_MANAGER_USERNAME=branchmanager
BRANCH_MANAGER_PASSWORD=replace-with-a-strong-branch-manager-password
BRANCH_MANAGER_EMAIL=branch.manager@example.com
SEED_ACCOUNT_PASSWORDS=true

# Payment provider
BOOKING_PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
VNPAY_TMN_CODE=replace-with-vnpay-terminal-code
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret

# Notification provider
MAIL_USERNAME=replace-with-mail-account
MAIL_PASSWORD=replace-with-mail-app-password
